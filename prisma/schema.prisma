generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  STAFF
  ADMIN
}

enum OrderStatus {
  PENDING
  PROCESSING
  PAID
  PARTIALLY_REFUNDED
  REFUNDED
  PAYMENT_FAILED
  CANCELLED
  FULFILLMENT_ERROR
}

enum FulfillmentStatus {
  PENDING
  PROCESSING
  COMPLETED
  ERROR
}

enum TicketStatus {
  ISSUED
  VALID
  USED
  CANCELLED
  REFUNDED
}

enum MediaType {
  IMAGE
  VIDEO
}

model User {
  id            String  @id @default(cuid())
  name          String?
  email         String  @unique
  emailVerified Boolean @default(false)
  image         String?
  role          Role    @default(USER)

  sessions         Session[]
  accounts         Account[]
  orders           Order[]
  pointTransactions PointTransaction[]
  rewardRedemptions RewardRedemption[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

enum PointTransactionType {
  PURCHASE
  BONUS
  REWARD_REDEMPTION
  REFUND
  EXPIRATION
  ADMIN_ADJUSTMENT
}

model PointTransaction {
  id          String               @id @default(cuid())
  userId      String
  points      Int
  type        PointTransactionType
  referenceId String?
  description String?
  createdAt   DateTime             @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  // Idempotency: a given (type, referenceId) pair can only produce one movement.
  // referenceId is nullable for admin adjustments / manual bonuses, which are
  // not deduplicated.
  @@unique([type, referenceId])
}

enum RedemptionStatus {
  PENDING
  REDEEMED
  EXPIRED
  CANCELLED
}

model Reward {
  id             String   @id @default(cuid())
  name           String
  description    String?

  pointsCost     Int

  salePriceCents Int?
  realCostCents  Int?

  active         Boolean  @default(true)

  stock          Int?
  maxPerUser     Int?
  maxPerEvent    Int?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  redemptions RewardRedemption[]
}

model RewardRedemption {
  id          String           @id @default(cuid())
  userId      String
  rewardId    String

  pointsSpent Int

  token       String           @unique

  status      RedemptionStatus @default(PENDING)

  expiresAt   DateTime
  redeemedAt  DateTime?

  createdAt   DateTime         @default(now())

  user   User   @relation(fields: [userId], references: [id])
  reward Reward @relation(fields: [rewardId], references: [id])

  @@index([userId, createdAt])
  @@index([rewardId, status])
}

// Single-row configuration table (id = "main"). Lets the admin change loyalty
// rules (points per euro, QR validity window) without touching code.
model LoyaltyConfig {
  id                String  @id @default("main")
  pointsPerEuro     Int     @default(10)
  qrValiditySeconds Int     @default(90)

  updatedAt         DateTime @updatedAt
}

model Venue {
  id        String  @id @default(cuid())
  name      String
  slug      String  @unique
  address   String?
  city      String?
  capacity  Int?
  latitude  Float?
  longitude Float?
  instagram String?
  website   String?

  events Event[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MediaAsset {
  id       String    @id @default(cuid())
  url      String
  publicId String?
  alt      String?
  type     MediaType @default(IMAGE)

  coverEvents Event[]
  artists     Artist[]
  gallery     GalleryImage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Event {
  id    String @id @default(cuid())
  title String
  slug  String @unique

  description String

  startDate DateTime
  endDate   DateTime?

  coverImageId String?
  coverImage   MediaAsset? @relation(fields: [coverImageId], references: [id])

  venueId String
  venue   Venue  @relation(fields: [venueId], references: [id])

  published Boolean @default(false)

  images       GalleryImage[]
  artists      EventArtist[]
  ticketTypes  TicketType[]
  orders       Order[]
  translations EventTranslation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EventTranslation {
  id          String @id @default(cuid())
  eventId     String
  event       Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  locale      String
  title       String
  description String

  @@unique([eventId, locale])
}

model GalleryImage {
  id String @id @default(cuid())

  alt      String?
  order    Int     @default(0)
  featured Boolean @default(false)

  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  mediaAssetId String
  mediaAsset   MediaAsset @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Artist {
  id         String      @id @default(cuid())
  name       String
  slug       String      @unique
  bio        String?
  imageId    String?
  image      MediaAsset? @relation(fields: [imageId], references: [id])
  instagram  String?
  soundcloud String?
  spotify    String?
  resident   Boolean     @default(false)

  events       EventArtist[]
  translations ArtistTranslation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ArtistTranslation {
  id       String @id @default(cuid())
  artistId String
  artist   Artist @relation(fields: [artistId], references: [id], onDelete: Cascade)
  locale   String
  bio      String

  @@unique([artistId, locale])
}

model EventArtist {
  eventId  String
  artistId String

  setStart DateTime?
  setEnd   DateTime?

  event  Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  artist Artist @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@id([eventId, artistId])
}

model TicketType {
  id         String  @id @default(cuid())
  name       String
  priceCents Int
  stock      Int

  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  tickets Ticket[]
  orderItems OrderItem[]

  @@unique([eventId, name])
}

model Order {
  id              String           @id @default(cuid())
  status          OrderStatus      @default(PENDING)
  fulfillmentStatus FulfillmentStatus @default(PENDING)

  currency        String           @default("eur")
  subtotalCents   Int
  totalCents      Int

  stripeCheckoutId String?         @unique
  stripePaymentId  String?
  stripeCustomerId String?

  paidAt          DateTime?
  fulfilledAt     DateTime?
  fulfillmentError String?

  userId String
  user   User   @relation(fields: [userId], references: [id])

  eventId String
  event   Event  @relation(fields: [eventId], references: [id])

  items   OrderItem[]
  tickets Ticket[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt])
  @@index([status])
  @@index([fulfillmentStatus])
}

model OrderItem {
  id            String @id @default(cuid())

  orderId       String
  order         Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  ticketTypeId  String?
  ticketType    TicketType? @relation(fields: [ticketTypeId], references: [id])

  nameSnapshot  String
  priceCents    Int
  quantity      Int

  pointsAwarded Int @default(0)

  @@index([orderId])
}

model Ticket {
  id          String       @id @default(cuid())
  code        String       @unique
  status      TicketStatus @default(VALID)
  checkedIn   Boolean      @default(false)
  checkedInAt DateTime?

  // Snapshot of the ticket type name + price at issuance time, so historical
  // tickets don't change if the TicketType is edited later.
  nameSnapshot String
  priceCents   Int

  orderId String
  order   Order  @relation(fields: [orderId], references: [id])

  ticketTypeId String
  ticketType   TicketType @relation(fields: [ticketTypeId], references: [id])

  @@index([orderId])
  @@index([ticketTypeId])
}

model StripeWebhookEvent {
  id             String   @id @default(cuid())

  stripeEventId  String   @unique
  type           String

  processed      Boolean  @default(false)
  attempts       Int      @default(0)

  error          String?

  createdAt      DateTime @default(now())
  processedAt    DateTime?

  @@index([processed])
}

model NewsletterSubscriber {
  id         String   @id @default(cuid())
  email      String   @unique
  subscribed Boolean  @default(true)
  createdAt  DateTime @default(now())
}

model SiteSettings {
  id              String  @id @default("main")
  heroTitle       String
  heroDescription String
  instagram       String?
  soundcloud      String?
  spotify         String?

  welcomeEmailSubject String? @default("Bienvenido a FADER")
  welcomeEmailContent String? @default("Estás dentro. A partir de ahora recibirás información sobre próximos eventos, preventas y anuncios antes que nadie.")
  welcomeEmailCtaText String? @default("Comprar entradas")
  welcomeEmailCtaUrl  String?
  welcomeEmailImage   String?
}
