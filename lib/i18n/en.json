  "manifesto": {
    "label": "01 — Manifesto",
    "title": "Music as ritual",
    "body": "FADER is born as a collective dedicated to underground electronic music in Alicante. We don't chase trends or labels. We seek atmosphere, progressive tension and sound that transforms.",
    "points": [
      "Curated programming, not impulsive",
      "Resident artists and international guests",
      "Club culture as a space for community"
    ]
