  "artists": {
    "label": "03 — Artists",
    "title": "Residents",
    "resident": "Resident",
    "descriptions": {
      "LITN": "LITN is a project centered on deep techno, with selections that move between the hypnotic and the dark. Its sound is characterized by atmospheric layers, deep bass and a musical narrative that builds progressive tension. A regular resident at FADER events.",
      "Cristian Camilo": "Cristian Camilo explores hypnotic techno with a minimalist and immersive approach. His sets combine underground rhythms, dense textures and progressions that keep the audience in a trance state. A fundamental part of the FADER collective.",
      "RUISUK": "RUISUK is a project centered on techno with a selection that mixes the industrial and the hypnotic. FADER resident, his sets are characterized by punchy rhythms and dense atmospheres that build a sonic journey without concessions."
    }
  },
  "historia": {
    "label": "04 — History",
    "title": "Our story",
    "blocks": {
      "origen": {
        "title": "Origins",
        "body": "From our beginnings we have strived to create an intimate experience and build a solid proposal for our community."
      },
      "enfoque": {
        "title": "Musical focus",
        "body": "Our identity is born from techno and minimal, exploring different branches of house without losing our essence. We are drawn to hypnotic, deep and elegant sounds, always driven by a solid groove that connects with the dancefloor."
      },
      "experiencia": {
        "title": "Club experience",
        "body": "Every event is designed from scratch. Lights, visuals, schedules and atmosphere are conceived as part of a single experience, where music is the axis that connects everything. We understand the dancefloor as a meeting space, where sound, darkness and the environment favor a real connection between those who share it."
      },
      "comunidad": {
        "title": "Community",
        "body": "FADER is not just a music collective but a community where we combine tastes for art and sound seeking to connect people."
      }
    }
  },
